<view class="app theme-{{theme}}">
<view class="page">
  <view class="header">
    <view><view class="title">节拍器</view><view class="subtitle">木吉他 · 电吉他 · 每一拍都专注</view></view>
    <button class="settings-button" data-panel="settings" bindtap="openPanel">设置</button>
  </view>

  <view class="mode-switch">
    <button class="{{mode === 'metronome' ? 'selected' : ''}}" data-key="mode" data-value="metronome" bindtap="selectOption" disabled="{{busy}}">节拍器 · {{beats}}/4</button>
    <button class="{{mode === 'drums' ? 'selected' : ''}}" data-key="mode" data-value="drums" bindtap="selectOption" disabled="{{busy}}">鼓伴奏 · {{beats}}/4</button>
  </view>

  <view class="tempo">
    <view class="beat-dots" aria-label="{{beats}} 拍{{currentBeat >= 0 ? '，当前第 ' + (currentBeat + 1) + ' 拍' : ''}}">
      <view wx:for="{{beatDots}}" wx:key="*this" class="dot {{index === 0 && (accent || mode === 'drums') ? 'accent' : ''}} {{currentBeat === index ? 'playing' : ''}}"></view>
    </view>
    <button class="bpm-number" data-panel="bpm" bindtap="openPanel" disabled="{{busy}}">{{bpm}}</button>
    <view class="bpm-label">BPM · 点击数字输入</view>
    <view class="tempo-controls">
      <button class="step-button" data-step="-1" bindtap="stepBpm" disabled="{{busy || bpm === 40}}" aria-label="降低 5 BPM">−</button>
      <view class="tempo-caption">找到你的练习速度</view>
      <button class="step-button" data-step="1" bindtap="stepBpm" disabled="{{busy || bpm === 240}}" aria-label="提高 5 BPM">＋</button>
    </view>
    <slider min="40" max="240" step="1" value="{{bpm}}" bindchange="slideBpm" disabled="{{busy}}" activeColor="{{theme === 'dark' ? '#75b7a7' : '#34766d'}}" backgroundColor="{{theme === 'dark' ? '#38483f' : '#e4e7e2'}}" block-color="{{theme === 'dark' ? '#75b7a7' : '#34766d'}}" block-size="22" />
    <view class="range"><text>40</text><text>240</text></view>
  </view>

  <view class="options">
    <block wx:if="{{mode === 'metronome'}}">
      <view class="option-pair">
        <button class="option" data-panel="beats" bindtap="openPanel" disabled="{{busy}}"><text class="label">拍号</text><text class="value">{{beats}}/4 <text class="chevron">›</text></text></button>
        <button class="option" data-panel="tone" bindtap="openPanel" disabled="{{busy}}"><text class="label">音色</text><text class="value">{{tone === 'voice-japanese' ? '日语女声' : tone === 'voice' ? '人声' : tone === 'soft' ? '柔和' : '电子'}} <text class="chevron">›</text></text></button>
      </view>
      <button class="option full" bindtap="toggleAccent" disabled="{{busy}}"><text class="label">首拍重音</text><text class="toggle {{accent ? 'enabled' : ''}}">{{accent ? '已开启' : '已关闭'}}</text></button>
    </block>
    <block wx:else>
      <view class="option-pair">
        <button class="option" data-panel="beats" bindtap="openPanel" disabled="{{busy}}"><text class="label">拍号</text><text class="value">{{beats}}/4 <text class="chevron">›</text></text></button>
        <button class="option" data-panel="kit" bindtap="openPanel" disabled="{{busy}}"><text class="label">鼓组</text><text class="value">{{kitLabel}} <text class="chevron">›</text></text></button>
      </view>
      <button class="option full" data-panel="pattern" bindtap="openPanel" disabled="{{busy}}"><text class="label">鼓点预设</text><text class="value">{{patternLabel}} <text class="chevron">›</text></text></button>
    </block>
    <button class="option full" data-panel="seconds" bindtap="openPanel" disabled="{{busy}}"><text class="label">练习时长</text><text class="value">{{seconds / 60}} 分钟 <text class="chevron">›</text></text></button>
  </view>

  <view class="playback">
    <view wx:if="{{state === 'generating'}}" class="generation"><progress percent="{{progress}}" activeColor="{{theme === 'dark' ? '#75b7a7' : '#34766d'}}" stroke-width="4" border-radius="4" /><text>{{progress}}%</text></view>
    <button class="primary" bindtap="primaryAction" disabled="{{busy || state === 'waiting'}}" loading="{{busy}}">{{busy ? '正在准备' : state === 'waiting' ? '正在连接播放器' : state === 'playing' ? '暂停练习' : state === 'paused' ? '继续练习' : state === 'error' ? '重试' : '开始练习'}}</button>
    <button class="primary end-button" bindtap="stopAndClean" disabled="{{busy || !ready}}" wx:if="{{state === 'playing' || state === 'paused' || state === 'waiting'}}">结束本次练习</button>
    <view class="status" aria-live="polite">{{status}}</view>
    <view class="footnote">四分音符计拍 · 播放中修改设置需重新开始</view>
  </view>
  <view class="author">Author: Steven · © {{year}}</view>
</view>

<view wx:if="{{panel}}" class="overlay" bindtap="closePanel">
  <view class="sheet" catchtap="preventClose">
    <view class="sheet-header"><text>{{panel === 'bpm' ? '练习速度' : panel === 'beats' ? '选择拍号' : panel === 'tone' ? '选择音色' : panel === 'seconds' ? '练习时长' : panel === 'kit' ? '选择鼓组' : panel === 'pattern' ? '选择鼓点' : '设置与帮助'}}</text><button class="close" bindtap="panelAction">{{panel === 'bpm' ? '保存' : '关闭'}}</button></view>
    <block wx:if="{{panel === 'bpm'}}">
      <input class="bpm-input" type="number" maxlength="3" value="{{bpmInput}}" bindinput="inputBpm" bindconfirm="confirmBpm" focus="{{panel === 'bpm'}}" confirm-type="done" adjust-position="true" />
      <view class="help">输入 40–240 的整数 BPM</view>
      <button class="primary" bindtap="confirmBpm">确定</button>
    </block>
    <block wx:elif="{{panel === 'beats'}}">
      <button wx:for="{{[2, 3, 4]}}" wx:key="*this" class="choice {{beats === item ? 'selected' : ''}}" data-key="beats" data-value="{{item}}" bindtap="selectOption">{{item}}/4 <text wx:if="{{beats === item}}">✓</text></button>
      <view class="help">BPM 以四分音符计拍，圆点表示每小节拍数。</view>
    </block>
    <block wx:elif="{{panel === 'tone'}}">
      <button class="choice {{tone === 'electronic' ? 'selected' : ''}}" data-key="tone" data-value="electronic" bindtap="selectOption">电子 <text wx:if="{{tone === 'electronic'}}">✓</text></button>
      <button class="choice {{tone === 'soft' ? 'selected' : ''}}" data-key="tone" data-value="soft" bindtap="selectOption">柔和 <text wx:if="{{tone === 'soft'}}">✓</text></button>
      <button class="choice {{tone === 'voice' ? 'selected' : ''}}" data-key="tone" data-value="voice" bindtap="selectOption">人声报拍 <text wx:if="{{tone === 'voice'}}">✓</text></button>
      <button class="choice {{tone === 'voice-japanese' ? 'selected' : ''}}" data-key="tone" data-value="voice-japanese" bindtap="selectOption">人声报拍（日语女声） <text wx:if="{{tone === 'voice-japanese'}}">✓</text></button>
      <view class="help">人声按拍号循环报数，提供英语与日语女声；开启首拍重音时，第 1 拍更响。音量请使用手机音量键调整。</view>
    </block>
    <block wx:elif="{{panel === 'seconds'}}">
      <button wx:for="{{[60, 300, 600]}}" wx:key="*this" class="choice {{seconds === item ? 'selected' : ''}}" data-key="seconds" data-value="{{item}}" bindtap="selectOption">{{item / 60}} 分钟 <text wx:if="{{seconds === item}}">✓</text></button>
      <view class="help">到时自动结束。开始前请保持前台，等待音频准备完成。</view>
    </block>
    <block wx:elif="{{panel === 'kit'}}">
      <button wx:for="{{kits}}" wx:key="id" class="choice {{kit === item.id ? 'selected' : ''}}" data-key="kit" data-value="{{item.id}}" bindtap="selectOption">{{item.label}} <text wx:if="{{kit === item.id}}">✓</text></button>
      <view class="help">使用 99Sounds 的底鼓、军鼓和闭合踩镲采样，音量用手机音量键调整。</view>
    </block>
    <block wx:elif="{{panel === 'pattern'}}">
      <button wx:for="{{patterns}}" wx:key="id" class="choice pattern-choice {{pattern === item.id ? 'selected' : ''}}" data-key="pattern" data-value="{{item.id}}" bindtap="selectOption"><view><view>{{item.label}}</view><view class="pattern-description">{{beats === 4 ? item.description : '取预设前 ' + beats + ' 拍，每小节重新循环'}}</view></view><text wx:if="{{pattern === item.id}}">✓</text></button>
      <view class="help">按所选 {{beats}}/4 拍循环；2/4、3/4 取原预设的前 2、3 拍，省略其余鼓点。</view>
    </block>
    <block wx:else>
      <view class="settings-label">外观</view>
      <view class="theme-options">
        <button class="choice {{themePreference === 'light' ? 'selected' : ''}}" data-value="light" bindtap="selectTheme">保持浅色 <text wx:if="{{themePreference === 'light'}}">✓</text></button>
        <button class="choice {{themePreference === 'dark' ? 'selected' : ''}}" data-value="dark" bindtap="selectTheme">保持深色 <text wx:if="{{themePreference === 'dark'}}">✓</text></button>
        <button class="choice {{themePreference === 'system' ? 'selected' : ''}}" data-value="system" bindtap="selectTheme">跟随系统 <text wx:if="{{themePreference === 'system'}}">✓</text></button>
      </view>
      <view class="help">默认跟随系统；切换外观不会中断练习。</view>
      <view class="help">适用于木吉他和电吉他练习。上次设置会保存在本机。</view>
      <view class="help">听到声音后可以锁屏练习。来电、其他音频或强制退出微信可能中断播放。</view>
      <view class="help">圆点的外圈标记当前播放拍，暂停或锁屏时停止动画，回到前台重新对齐。画面仅作辅助，以声音为准。修改参数后，重新开始会按完整时长播放。</view>
      <view class="help">结束练习后自动清理生成音频。播放或暂停时保留文件用于继续练习；异常退出的残留会在下次进入时清理。</view>
      <button class="choice" data-panel="diagnostics" bindtap="openPanel">{{panel === 'diagnostics' ? '收起诊断信息' : '查看诊断信息'}} <text>{{panel === 'diagnostics' ? '⌃' : '⌄'}}</text></button>
      <block wx:if="{{panel === 'diagnostics'}}">
        <view class="diagnostics" bindtap="copyDiagnostics" aria-label="点击复制全部诊断信息">
          <view>{{status}}</view><view>{{cleanupStatus}}</view><view>{{storageStatus}}</view><view wx:if="{{filePath}}">{{filePath}}</view>
          <view class="log" wx:for="{{logs}}" wx:key="id">{{item.text}}</view>
        </view>
        <button class="choice" bindtap="copyDiagnostics">复制全部诊断信息</button>
        <button class="choice" bindtap="stopAndClean" disabled="{{busy || !ready}}">停止并清理全部运行数据</button>
        <view class="help">清除生成音频、残留文件、日志和运行缓存，保留你的输入与设置。</view>
      </block>
    </block>
  </view>
</view>

</view>
