page { background: #f5f5f5; color: #222; }
.page { padding: 40rpx; }
.title { font-size: 40rpx; font-weight: 600; margin-bottom: 20rpx; }
.description { color: #555; font-size: 28rpx; margin-bottom: 12rpx; }
.picker { background: white; padding: 28rpx; margin: 36rpx 0 24rpx; border-radius: 12rpx; }
button { margin-bottom: 20rpx; }
.status { font-weight: 600; margin: 32rpx 0 20rpx; }
.path, .log { overflow-wrap: anywhere; font-family: monospace; font-size: 24rpx; }
.hint { color: #666; font-size: 26rpx; margin: 24rpx 0; line-height: 1.6; }
.log { background: white; padding: 12rpx; margin-bottom: 4rpx; }
